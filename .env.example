# Variables à créer dans Vercel : Project > Settings > Environment Variables
GYM_DB_HOST=votre-hote-mysql.example.com
GYM_DB_PORT=3306
GYM_DB_NAME=gym_squale
GYM_DB_USER=utilisateur
GYM_DB_PASS=mot-de-passe
# Mets 1 si ta base impose une connexion chiffrée (Aiven, TiDB Cloud, etc.)
GYM_DB_SSL=1
# Facultatif : fichier de certificat de l'autorité (CA) fourni par ton hébergeur MySQL.
# Dépose-le dans le dossier app/ (ex. app/ca.pem) et indique son nom ici.
# GYM_DB_SSL_CA=ca.pem
